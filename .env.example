# =============================================================
# 企业 AI 辅助工具 · 环境变量模板
# 复制为 .env 并按需修改：#   cp .env.example .env
# .env 被 .gitignore 排除，不会提交到 GitHub
# =============================================================

# ---------- 服务 ----------
# 监听端口（云服务器固定 3000，配合 nginx 反代）
# PORT=3000

# 监听地址（0.0.0.0 允许外部访问；生产环境建议配合防火墙只用 nginx 访问）
# HOST=0.0.0.0

# 只读模式：开启后 guest 角色所有写操作被后端拦截（对外演示用）
# READONLY_MODE=true

# ---------- 大模型（默认 mock，无需 Key 即可跑通） ----------
# LLM_MODE=mock            # mock=本地组装（默认） | real=调用真实模型
# LLM_API_KEY=             # real 模式必填
# LLM_BASE_URL=            # real 模式必填，如 https://api.openai.com/v1
# LLM_MODEL=               # real 模式必填，如 gpt-4o / doubao-seed-1-6-250615
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=4096
# LLM_TIMEOUT_MS=60000